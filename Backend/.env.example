# development or production
APP_ENV=development

# The allowed origin domain(s) for frontend applications.
CLIENT_URL=http://localhost:3000

# The trusted proxy IP address or CIDR range for the application.
TRUSTED_PROXIES=10.0.0.0/8

# Database Connection

DB_URL=postgres://tamcon_user:tamcon_password@localhost:5432/tamcon_db?sslmode=disable

# Server Configuration
PORT=8080

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI API Configuration
GEMINI_API_KEY=

# Cloudinary URL
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<product_environment>